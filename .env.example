# Copy this file to .env and fill in your Alpaca keys.
# Get paper-trading keys at https://app.alpaca.markets (Paper Trading -> API Keys).
ALPACA_API_KEY=your_key_here
ALPACA_API_SECRET=your_secret_here

# Keep this true until you have tested the strategy thoroughly.
ALPACA_PAPER=true

# Which strategy to run: ema_cross_vwap (the original) or v3 (v3.1 system,
# trades TQQQ/SQQQ based on the QQQ morning regime; SYMBOLS is ignored).
STRATEGY=ema_cross_vwap

# Comma-separated list of symbols to trade (original strategy only).
SYMBOLS=SPY,QQQ

# Optional overrides (defaults shown)
# TIMEFRAME_MINUTES=5
# EMA_FAST=9
# EMA_SLOW=21
# ATR_PERIOD=14
# STOP_ATR=1.5
# TARGET_ATR=3.0
# RISK_PER_TRADE=0.01
# MAX_POSITION_PCT=0.25
# MAX_DAILY_LOSS_PCT=0.03
# SLIPPAGE_BPS=2

# Small accounts (under SMALL_ACCOUNT_LIMIT): fractional shares, a larger position
# cap, and a guard against the pattern-day-trader rule (max 3 day trades / 5 days).
# FRACTIONAL_SHARES=auto
# SMALL_ACCOUNT_LIMIT=25000
# SMALL_ACCOUNT_MAX_POSITION_PCT=0.5
# PDT_GUARD=true

# Daily self-improvement (runs after each trading day; defaults shown)
# LEARNING_ENABLED=true
# LEARN_TRAIN_DAYS=30
# LEARN_VAL_DAYS=10
# LEARN_CANDIDATES=24
# LEARN_MARGIN=2.0
# LEARN_COOLDOWN_DAYS=10
# LEARN_MIN_TRADES=10
# STATE_PATH=state/learning.json

# v3.1 system (defaults shown). Learning tunes STOP_PCT, SHIELD_R, SCALE_R_AM,
# TIME_STOP_MIN and BAND_SD; the rest stay as set here.
# V3_RISK_PCT=0.005
# V3_MAX_DAILY_LOSS_PCT=0.01
# V3_MAX_POSITION_PCT=0.5
# V3_STOP_PCT=0.008
# V3_SHIELD_R=0.6
# V3_SCALE_R_AM=1.0
# V3_SCALE_R_PM=0.7
# V3_PM_LOCK_R=0.25
# V3_TIME_STOP_MIN=30
# V3_TIME_STOP_R=0.4
# V3_COOLDOWN_MIN=10
# V3_ORB_QQQ_PCT=0.35
# V3_TREND_PCT=0.5
# V3_TREND_SLOPE=0.15
# V3_BAND_SD=2.0
# V3_VWAP_GAP_PCT=0.6
# V3_EXHAUSTION_PCT=1.75
# V3_VWAP_TARGET=false
# V3_TREND_DAYS_ONLY=false
# V3_ENTRY_CUTOFF=15:45
